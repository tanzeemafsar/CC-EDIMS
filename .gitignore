# Secrets — never commit real credentials
.env

# Dependencies — installed via npm install/ci, not committed
node_modules/

# TLS certificates — generated per-deployment by scripts/gen-local-cert.sh
certs/

# Runtime logs (PM2 out_file/error_file point here)
logs/
*.log

# Uploaded receipts — user data, back these up with the database
uploads/

# Scraped hardware images — runtime cache, not source
public/images/hardware/*
!public/images/hardware/.gitkeep

# OS/editor noise
.DS_Store
*.swp
.env1
