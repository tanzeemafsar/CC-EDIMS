# =============================================================================
# EDIMS — .env
# PLACEHOLDER VALUES. Replace before running against a real database.
#
#   DATABASE_URL    — your actual PostgreSQL connection string
#   SESSION_SECRET  — generate your own with: openssl rand -hex 32
#                     (the value below is a published example; do not use it
#                     in any environment that isn't fully local/throwaway)
#
# CERT_KEY_PATH / CERT_CRT_PATH are optional — only needed if your certs
# live somewhere other than ./certs/local-cert.{key,crt} (the default
# scripts/gen-local-cert.sh produces).
#
# TRUST_PROXY — set to "true" only if EDIMS sits behind a reverse proxy or
# load balancer (nginx, ALB, Cloudflare, etc). Leave unset/false for direct
# LAN deployment, otherwise req.ip becomes spoofable via X-Forwarded-For.
# =============================================================================
DATABASE_URL=postgres://user:pass@localhost:5432/edims
SESSION_SECRET=9c1d56e159ab3d82f7c62b083a2d45e7f10bcf2e8da9d8c37b4e2a15f06de24b
NODE_ENV=production
PORT=3000
TRUST_PROXY=false
